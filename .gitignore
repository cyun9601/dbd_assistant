# 의미기반 AI용 모델/라이브러리 — 용량이 크고(>100MB) 재생성 가능.
# 'python download_model.py' 로 언제든 다시 받는다. (GitHub 100MB 제한 회피)
models/
vendor/

# 파이썬/노드 부산물
__pycache__/
*.pyc
node_modules/
package-lock.json
package.json

# 즐겨찾기 — 사용자별 로컬 데이터 (서버가 자동 생성, 공유하지 않음)
favorites.json

# API 키 — 사용자별 로컬 데이터 (DPAPI 암호화, 절대 공유 금지)
config.json

# 태그 — 기본 태그는 tags.json(공유), 사용자가 수정한 분량만 따로 보관(공유 안 함)
tags_user.json

# PyInstaller 빌드 산출물 (exe 배포용, 재생성 가능)
build/
dist/
*.manifest

# OS/IDE
.DS_Store
Thumbs.db

# 편집기 원자적 쓰기 임시 파일 (Dropbox가 파일을 잠그면 정리가 안 되고 남을 수 있음)
*.tmp.*
